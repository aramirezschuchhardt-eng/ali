# URL pública del sitio (canonical, Open Graph, sitemap)
PUBLIC_SITE_URL=https://www.ejemplo.cl

# --- Captación de leads (solo servidor; nunca exponer en el cliente) ---
# Webhook que recibe los leads (HubSpot, Zapier, Make, n8n, CRM propio...).
# Si no está definido, el formulario informa que la integración está pendiente.
LEAD_WEBHOOK_URL=
# Token opcional enviado como "Authorization: Bearer <token>" al webhook.
LEAD_WEBHOOK_TOKEN=
# Solo desarrollo: si vale 1 y no hay webhook, el lead se imprime en la consola del servidor.
LEAD_DEV_LOG=0
