---
import { getCollection } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArchVisual from '@/components/ArchVisual.astro';
import SectionHeading from '@/components/SectionHeading.astro';
import MethodTimeline from '@/components/MethodTimeline.astro';
import ObjectiveCards from '@/components/ObjectiveCards.astro';
import FaqAccordion from '@/components/FaqAccordion.astro';
import PostCard from '@/components/PostCard.astro';
import CtaBand from '@/components/CtaBand.astro';
import TeamGrid from '@/components/TeamGrid.astro';
import CaseList from '@/components/CaseList.astro';
import { site } from '@/config/site';
import { pillars } from '@/data/content';
import { faq } from '@/data/faq';
import { strategyQuestions } from '@/data/content';

const posts = (await getCollection('blog', (p) => !p.data.draft)).slice(0, 3);
const bookingHref = site.bookingUrl ?? '/contacto#diagnostico';
---
<BaseLayout
  title="Asesoría de inversión inmobiliaria en Chile | Avance Inmobiliario"
  description="Construye una estrategia de inversión inmobiliaria alineada con tus objetivos y tu capacidad financiera. Diagnóstico, escenarios financieros y acompañamiento."
>
  <!-- 1. Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div class="hero-copy">
        <span class="eyebrow">Asesoría estratégica de inversión inmobiliaria</span>
        <h1>Tu patrimonio merece algo más que una propiedad.</h1>
        <p class="lead">En {site.name} te ayudamos a construir una estrategia de inversión alineada con tus objetivos, tu capacidad financiera y tu visión de futuro.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href={bookingHref} data-cta="hero-agendar">Agenda una asesoría estratégica</a>
          <a class="btn btn-secondary" href="/metodo" data-cta="hero-metodo">Descubre nuestro método</a>
        </div>
        <p class="hero-note small muted">Para quienes invierten por primera vez, quienes ya tienen propiedades y quienes buscan diversificar su patrimonio.</p>
      </div>
      <div class="hero-visual" aria-hidden="false">
        <ArchVisual variant="hero" seed={7} label="Ilustración de un edificio contemporáneo" />
        <div class="hero-card">
          <span class="eyebrow">Nuestro enfoque</span>
          <p>Primero entendemos tus objetivos. Después evaluamos las oportunidades.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- 2. El problema -->
  <section class="section" aria-labelledby="problema">
    <div class="container">
      <div class="problem-head">
        <h2 id="problema" class="reveal">Comprar una propiedad no es lo mismo que hacer una buena inversión.</h2>
        <p class="lead reveal">Una propiedad puede parecer atractiva y aun así no ser la decisión adecuada para tu situación. Antes de invertir, necesitas comprender tus objetivos, tu capacidad financiera, las condiciones del financiamiento y el papel que esa propiedad podría desempeñar en tu patrimonio.</p>
      </div>
      <ol class="grid grid-3 problem-steps">
        <li class="card reveal"><span class="num">01</span><h3>Entendemos tu situación</h3><p class="muted">Analizamos tus objetivos, capacidad de ahorro, compromisos financieros y expectativas.</p></li>
        <li class="card reveal"><span class="num">02</span><h3>Diseñamos tu estrategia</h3><p class="muted">Evaluamos qué tipo de inversión podría tener sentido para tu perfil y horizonte de tiempo.</p></li>
        <li class="card reveal"><span class="num">03</span><h3>Evaluamos las oportunidades</h3><p class="muted">Comparamos alternativas y escenarios antes de tomar una decisión.</p></li>
      </ol>
      <p class="claim reveal">Primero la estrategia. Después, la propiedad.</p>
    </div>
  </section>

  <!-- 3. Metodología -->
  <section class="section section-alt" aria-labelledby="metodologia">
    <div class="container">
      <SectionHeading eyebrow="Método Avance" title="Un método para invertir con mayor claridad." id="metodologia" lead="Cinco etapas para pasar de una idea general a una decisión informada." />
      <MethodTimeline />
      <a class="btn btn-secondary" href="/metodo">Conoce el método en detalle</a>
    </div>
  </section>

  <!-- 4. Según tu objetivo -->
  <section class="section" aria-labelledby="objetivos">
    <div class="container">
      <SectionHeading eyebrow="Asesoría según tu objetivo" title="Tu estrategia depende de dónde quieres llegar." id="objetivos" />
      <ObjectiveCards />
    </div>
  </section>

  <!-- 5. Qué define tu estrategia -->
  <section class="section section-alt" aria-labelledby="estrategia">
    <div class="container">
      <SectionHeading eyebrow="Tu estrategia" title="Las preguntas que una estrategia responde antes de comprar." id="estrategia" lead="Una buena inversión empieza con respuestas claras. Estas son las que trabajamos contigo, en este orden." />
      <ol class="questions">
        {strategyQuestions.map((q, i) => (
          <li class="question reveal">
            <span class="q-n" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3>{q.q}</h3>
              <p class="muted">{q.a}</p>
            </div>
          </li>
        ))}
      </ol>
      <p class="claim reveal">Invierte con una visión más amplia.</p>
    </div>
  </section>

  <!-- 5b. Simulador -->
  <section class="section" aria-labelledby="numeros">
    <div class="container sim-teaser reveal">
      <div>
        <span class="eyebrow">Simulador de inversión</span>
        <h2 id="numeros">Entiende los números antes de invertir.</h2>
        <p class="lead">Calcula el pie, el dividendo aproximado, el flujo de caja mensual y la rentabilidad de un escenario. Compara supuestos conservadores, base y optimistas.</p>
        <div class="btn-row">
          <a class="btn btn-primary" href="/simulador" data-cta="home-simulador">Probar el simulador</a>
          <a class="btn btn-secondary" href={bookingHref} data-cta="home-simulador-asesor">Analizar mi escenario con un asesor</a>
        </div>
      </div>
      <dl class="sim-concepts">
        <div><dt>Flujo de caja</dt><dd>Lo que entra y sale cada mes, con vacancia, gastos y dividendo.</dd></div>
        <div><dt>Rentabilidad bruta y neta</dt><dd>Cuánto rinde la propiedad antes y después de costos.</dd></div>
        <div><dt>Retorno sobre tu capital</dt><dd>El efecto real del crédito sobre lo que aportas.</dd></div>
      </dl>
    </div>
  </section>

  <!-- 6. Por qué Avance -->
  <section class="section section-dark" aria-labelledby="por-que">
    <div class="container">
      <SectionHeading eyebrow={`Por qué ${site.name}`} title="Una asesoría que comienza por tus intereses." id="por-que" />
      <div class="grid grid-4 pillars">
        {pillars.map((p, i) => (
          <div class="pillar reveal"><span class="pillar-n">0{i + 1}</span><h3>{p.title}</h3><p>{p.text}</p></div>
        ))}
      </div>
    </div>
  </section>

  <!-- 7. Casos -->
  <section class="section" aria-labelledby="casos">
    <div class="container">
      <SectionHeading eyebrow="Casos y experiencias" title="Estrategias construidas en torno a objetivos reales." id="casos" />
      <CaseList limit={2} />
    </div>
  </section>

  <!-- 8. Equipo -->
  <section class="section section-alt" aria-labelledby="equipo">
    <div class="container">
      <SectionHeading eyebrow="Equipo asesor" title="Personas que te acompañan a decidir mejor." id="equipo" />
      <TeamGrid />
    </div>
  </section>

  <!-- 9. Contenido educativo -->
  <section class="section" aria-labelledby="aprende">
    <div class="container">
      <SectionHeading eyebrow="Centro de contenidos" title="Invierte mejor cuando entiendes mejor." id="aprende" lead="Guías claras para tomar decisiones con criterio, sin letra chica." />
      <div class="grid grid-3">{posts.map((p, i) => <PostCard post={p} index={i} />)}</div>
      <div class="btn-row more"><a class="btn btn-secondary" href="/blog">Ver todos los artículos</a></div>
    </div>
  </section>

  <!-- 10. FAQ -->
  <section class="section section-alt" aria-labelledby="faq">
    <div class="container faq-grid">
      <div>
        <SectionHeading eyebrow="Preguntas frecuentes" title="Respuestas claras antes de empezar." id="faq" />
        <p class="muted small">Las respuestas son de carácter general y no reemplazan un análisis de tu caso.</p>
        <a class="btn btn-ghost" href="/preguntas-frecuentes">Ver todas las preguntas →</a>
      </div>
      <FaqAccordion items={faq.slice(0, 6)} />
    </div>
  </section>

  <!-- 11. CTA final -->
  <CtaBand />
</BaseLayout>

<style>
  .hero { padding-block: clamp(2.5rem, 6vw, 5.5rem) var(--space-8); overflow: hidden; }
  .hero-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; }
  .hero h1 { margin-bottom: var(--space-5); }
  .hero .lead { margin-bottom: var(--space-6); }
  .hero-note { margin-top: var(--space-5); max-width: 48ch; }
  .hero-visual { position: relative; aspect-ratio: 4 / 5; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow-lg); }
  .hero-card { position: absolute; left: var(--space-4); right: var(--space-4); bottom: var(--space-4); background: rgba(255,255,255,0.94); backdrop-filter: blur(8px); border-radius: var(--radius); padding: var(--space-4) var(--space-5); }
  .hero-card p { margin: 0; font-family: var(--font-display); font-size: var(--fs-lg); color: var(--ink); line-height: 1.3; }
  .hero-card .eyebrow { margin-bottom: var(--space-1); }
  @media (max-width: 900px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-visual { aspect-ratio: 16 / 11; }
  }
  .problem-head { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-7); margin-bottom: var(--space-7); align-items: end; }
  @media (max-width: 900px) { .problem-head { grid-template-columns: 1fr; gap: var(--space-4); } }
  .problem-steps { list-style: none; padding: 0; margin: 0; }
  .num { font-family: var(--font-display); color: var(--brand-orange); font-size: 2rem; display: block; margin-bottom: var(--space-3); line-height: 1; }
  .claim { margin: var(--space-7) 0 0; font-family: var(--font-display); font-size: var(--fs-xl); color: var(--ink); text-align: center; }
  .claim::before { content: ''; display: block; width: 48px; height: 3px; background: var(--brand-orange); margin: 0 auto var(--space-4); }
  .more { margin-top: var(--space-6); justify-content: center; }
  .questions { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--space-7); }
  @media (max-width: 860px) { .questions { grid-template-columns: 1fr; } }
  .question { display: grid; grid-template-columns: 56px 1fr; gap: var(--space-4); padding-block: var(--space-5); border-top: 1px solid var(--border-strong); }
  .q-n { font-family: var(--font-display); font-size: 1.6rem; color: var(--brand-orange); line-height: 1.2; }
  .question h3 { font-family: var(--font-display); font-weight: 500; font-size: var(--fs-xl); line-height: 1.2; margin-bottom: var(--space-2); }
  .question p { margin: 0; }
  .sim-teaser { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: var(--space-7); align-items: center; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.5rem, 4vw, 3.5rem); box-shadow: var(--shadow); }
  @media (max-width: 900px) { .sim-teaser { grid-template-columns: 1fr; } }
  .sim-teaser > * { min-width: 0; }
  .sim-concepts { margin: 0; display: grid; gap: var(--space-4); }
  .sim-concepts div { border-left: 3px solid var(--brand-orange); padding-left: var(--space-4); }
  .sim-concepts dt { font-weight: 600; }
  .sim-concepts dd { margin: 0; color: var(--text-muted); font-size: var(--fs-sm); }
  .pillar { border-top: 2px solid var(--brand-orange); padding-top: var(--space-5); }
  .pillar-n { font-family: var(--font-display); color: var(--brand-orange); font-size: var(--fs-sm); letter-spacing: 0.1em; }
  .pillar h3 { margin-top: var(--space-3); }
  .faq-grid { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: var(--space-7); }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: var(--space-4); } }
</style>
