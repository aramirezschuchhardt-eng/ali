---
import BaseLayout from '@/layouts/BaseLayout.astro';
---
<BaseLayout title="Página no encontrada" description="La página que buscas no existe." noindex>
  <section class="section-lg"><div class="container container-narrow center">
    <span class="eyebrow">Error 404</span>
    <h1>Esta página no existe.</h1>
    <p class="lead">Puede que el enlace haya cambiado. Te dejamos algunos caminos útiles.</p>
    <div class="btn-row" style="justify-content:center"><a class="btn btn-primary" href="/">Ir al inicio</a><a class="btn btn-secondary" href="/simulador">Simulador</a><a class="btn btn-secondary" href="/contacto">Contacto</a></div>
  </div></section>
</BaseLayout>
