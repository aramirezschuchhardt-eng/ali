---
/** Barra fija inferior en móviles con las acciones de contacto principales. */
import { site, whatsappHref } from '@/config/site';
const wa = whatsappHref();
const bookingHref = site.bookingUrl ?? '/contacto#diagnostico';
---
<div class="mobile-cta" data-mobile-cta>
  <a class="btn btn-primary" href={bookingHref} data-cta="agendar-movil">Agenda una asesoría</a>
  {wa && <a class="btn btn-secondary wa" href={wa} target="_blank" rel="noopener" data-cta="whatsapp-movil" aria-label="Escríbenos por WhatsApp">WhatsApp</a>}
</div>
<style>
  .mobile-cta { display: none; }
  @media (max-width: 720px) {
    .mobile-cta {
      display: flex;
      gap: var(--space-2);
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 90;
      padding: var(--space-3) var(--space-4) calc(var(--space-3) + env(safe-area-inset-bottom));
      background: rgba(250, 248, 245, 0.96);
      border-top: 1px solid var(--border);
      backdrop-filter: blur(10px);
    }
    .mobile-cta .btn-primary { flex: 1; }
    :global(body) { padding-bottom: 76px; }
  }
</style>
