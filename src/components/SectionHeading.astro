---
interface Props { eyebrow?: string; title: string; lead?: string; align?: 'left' | 'center'; as?: 'h1' | 'h2'; id?: string; }
const { eyebrow, title, lead, align = 'left', as: Tag = 'h2', id } = Astro.props;
---
<header class:list={['section-heading', align === 'center' && 'center']}>
  {eyebrow && <span class="eyebrow">{eyebrow}</span>}
  <Tag id={id}>{title}</Tag>
  {lead && <p class="lead">{lead}</p>}
  <slot />
</header>
<style>
  .section-heading { margin-bottom: var(--space-7); max-width: 780px; }
  .section-heading.center { margin-inline: auto; }
</style>
