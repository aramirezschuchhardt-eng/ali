---
import { methodStages } from '@/data/content';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
---
<ol class:list={['timeline', detailed && 'timeline-detailed']}>
  {methodStages.map((s) => (
    <li class="stage reveal">
      <div class="stage-marker" aria-hidden="true"><span>{s.n}</span></div>
      <div class="stage-body">
        <h3><span class="sr-only">Etapa {Number(s.n)}. </span>{s.title}</h3>
        <p>{s.text}</p>
        {detailed && (
          <>
            <ul class="stage-detail">{s.detail.map((d) => <li>{d}</li>)}</ul>
            <p class="stage-output"><strong>Qué obtienes:</strong> {s.output}</p>
          </>
        )}
      </div>
    </li>
  ))}
</ol>
<style>
  .timeline { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(5, 1fr); gap: var(--space-4); counter-reset: s; position: relative; }
  .timeline::before { content: ''; position: absolute; top: 28px; left: 28px; right: 28px; height: 2px; background: linear-gradient(90deg, var(--brand-orange), var(--border)); }
  .stage { position: relative; }
  .stage-marker { width: 56px; height: 56px; border-radius: 50%; background: var(--surface); border: 2px solid var(--brand-orange); display: grid; place-items: center; position: relative; z-index: 1; margin-bottom: var(--space-4); transition: background 0.2s, transform 0.2s; }
  .stage-marker span { font-family: var(--font-display); font-weight: 500; font-size: 1.1rem; color: var(--ink); }
  .stage:hover .stage-marker { background: var(--brand-orange); transform: scale(1.05); }
  .stage h3 { font-size: var(--fs-lg); }
  .stage p { font-size: var(--fs-sm); color: var(--text-muted); }
  .stage-detail { margin: 0 0 var(--space-3); padding-left: 1.1em; font-size: var(--fs-sm); color: var(--text-muted); }
  .stage-output { font-size: var(--fs-sm); background: var(--brand-orange-soft); padding: var(--space-3); border-radius: var(--radius-sm); color: var(--text) !important; }
  .timeline-detailed { grid-template-columns: 1fr; gap: 0; }
  .timeline-detailed::before { top: 28px; bottom: 28px; left: 27px; right: auto; width: 2px; height: auto; background: linear-gradient(180deg, var(--brand-orange), var(--border)); }
  .timeline-detailed .stage { display: grid; grid-template-columns: 56px 1fr; gap: var(--space-5); padding-bottom: var(--space-6); }
  @media (max-width: 960px) {
    .timeline { grid-template-columns: 1fr; gap: 0; }
    .timeline::before { top: 28px; bottom: 28px; left: 27px; right: auto; width: 2px; height: auto; background: linear-gradient(180deg, var(--brand-orange), var(--border)); }
    .stage { display: grid; grid-template-columns: 56px 1fr; gap: var(--space-4); padding-bottom: var(--space-5); }
  }
</style>
