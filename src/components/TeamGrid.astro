---
import { team } from '@/data/team';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
const initials = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<div class="team">
  {team.map((m) => (
    <article class="card member reveal">
      <div class="photo">
        {m.photo ? <img src={m.photo.src} alt={m.photo.alt} loading="lazy" width="320" height="320" /> : <span aria-hidden="true">{initials(m.name)}</span>}
      </div>
      <div>
        <h3>{m.name}</h3>
        <p class="role">{m.role}</p>
        {m.specialty && <p class="small"><strong>Especialidad:</strong> {m.specialty}</p>}
        {detailed && m.experience && <ul class="small exp">{m.experience.map((e) => <li>{e}</li>)}</ul>}
        {m.approach && <p class="small muted">{m.approach}</p>}
      </div>
    </article>
  ))}
</div>
<style>
  .team { display: flex; flex-wrap: wrap; gap: var(--space-5); }
  .member { display: flex; align-items: center; gap: var(--space-5); flex: 0 1 380px; }
  .photo { flex: none; width: 88px; height: 88px; border-radius: 50%; overflow: hidden; background: var(--brand-orange-soft); display: grid; place-items: center; }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo span { font-family: var(--font-display); font-size: 1.8rem; color: var(--brand-orange-deep); }
  .member h3 { margin-bottom: var(--space-1); }
  .role { color: var(--brand-orange-deep); font-weight: 600; font-size: var(--fs-sm); margin: 0; }
  .exp { padding-left: 1.1em; }
</style>
