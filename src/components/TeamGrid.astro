---
import { team } from '@/data/team';
import Pending from './Pending.astro';
interface Props { detailed?: boolean; }
const { detailed = false } = Astro.props;
const initials = (n: string) => n.split(' ').filter(Boolean).slice(0, 2).map((w) => w[0]).join('');
---
<div class="grid grid-3 team">
  {team.map((m) => (
    <article class="card member reveal">
      <div class="photo">
        {m.photo ? <img src={m.photo.src} alt={m.photo.alt} loading="lazy" width="320" height="320" /> : <span aria-hidden="true">{initials(m.name)}</span>}
      </div>
      <h3>{m.name}</h3>
      <p class="role">{m.role}</p>
      <p class="small"><strong>Especialidad:</strong> {m.specialty}</p>
      {detailed && <ul class="small exp">{m.experience.map((e) => <li>{e}</li>)}</ul>}
      <p class="small muted">{m.approach}</p>
      {!m.verified && <Pending title="Validar antes de publicar"><p>{m.source}{!m.photo && ' Falta fotografía profesional autorizada.'}</p></Pending>}
    </article>
  ))}
  <Pending title="Perfiles del equipo">
    <p>Agregar a los demás integrantes reales del equipo asesor (nombre, cargo, fotografía profesional, experiencia verificable, especialidad y enfoque) en <code>src/data/team.ts</code>.</p>
  </Pending>
</div>
<style>
  .photo { width: 88px; height: 88px; border-radius: 50%; overflow: hidden; background: var(--brand-orange-soft); display: grid; place-items: center; margin-bottom: var(--space-4); }
  .photo img { width: 100%; height: 100%; object-fit: cover; }
  .photo span { font-family: var(--font-display); font-size: 1.8rem; color: var(--brand-orange-deep); }
  .role { color: var(--brand-orange-deep); font-weight: 600; font-size: var(--fs-sm); margin-bottom: var(--space-3); }
  .exp { padding-left: 1.1em; }
  .member :global(.pending) { margin-top: var(--space-4); }
</style>
