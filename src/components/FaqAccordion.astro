---
import type { FaqItem } from '@/data/faq';
interface Props { items: FaqItem[]; }
const { items } = Astro.props;
---
<div class="faq">
  {items.map((f) => (
    <details class="faq-item" name="faq">
      <summary><span>{f.q}</span><span class="icon" aria-hidden="true"></span></summary>
      <div class="faq-a"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--border); }
  .faq-item { border-bottom: 1px solid var(--border); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: var(--space-4); align-items: center; padding: var(--space-5) 0; font-weight: 600; font-size: var(--fs-md); }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--brand-orange-deep); }
  .icon { flex: none; width: 28px; height: 28px; border-radius: 50%; border: 1.5px solid var(--border-strong); position: relative; transition: transform 0.25s, background 0.2s; }
  .icon::before, .icon::after { content: ''; position: absolute; left: 50%; top: 50%; width: 11px; height: 1.5px; background: currentColor; transform: translate(-50%, -50%); }
  .icon::after { transform: translate(-50%, -50%) rotate(90deg); transition: transform 0.25s; }
  details[open] .icon { background: var(--brand-orange); border-color: var(--brand-orange); }
  details[open] .icon::after { transform: translate(-50%, -50%) rotate(0deg); }
  .faq-a { padding: 0 var(--space-7) var(--space-5) 0; color: var(--text-muted); }
</style>
