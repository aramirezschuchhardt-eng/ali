---
import { formatDelivery, goalLabels, minPriceUf, stageLabels, type Project } from '@/data/projects';
import { formatUf } from '@/lib/format';
import ArchVisual from './ArchVisual.astro';
import DataTag from './DataTag.astro';
interface Props { project: Project; index?: number; }
const { project: p, index = 0 } = Astro.props;
const price = minPriceUf(p);
const priceStatus = p.units.find((u) => u.priceFromUf?.value === price)?.priceFromUf?.status;
const typologies = [...new Set(p.units.map((u) => u.typology))];
const year = p.deliveryEstimate?.value.slice(0, 4) ?? '';
---
<article
  class="project-card reveal"
  data-project
  data-slug={p.slug}
  data-comuna={p.comuna}
  data-price={price ?? ''}
  data-typologies={typologies.join('|')}
  data-stage={p.stage}
  data-year={year}
  data-goals={p.goals.join('|')}
>
  <div class="pc-media">
    <ArchVisual image={p.image} variant="card" seed={index} label={p.image ? undefined : 'Imagen del proyecto pendiente de autorización'} />
    <div class="pc-badges">
      {p.demo && <span class="tag tag-demo">Demostración</span>}
      <span class="tag tag-neutral">{stageLabels[p.stage]}</span>
    </div>
  </div>
  <div class="pc-body">
    <h3><a href={`/oportunidades/${p.slug}`}>{p.name}</a></h3>
    <p class="pc-loc">{p.comuna}, {p.region}</p>
    <dl class="pc-facts">
      <div><dt>Tipologías</dt><dd>{typologies.join(' · ')}</dd></div>
      <div><dt>Desde</dt><dd>{price ? formatUf(price) : 'Por confirmar'} {priceStatus && <DataTag status={priceStatus} />}</dd></div>
      <div><dt>Entrega estimada</dt><dd>{formatDelivery(p.deliveryEstimate?.value)}</dd></div>
    </dl>
    <ul class="pc-highlights">{p.highlights.slice(0, 2).map((h) => <li>{h}</li>)}</ul>
    <p class="pc-goals small muted">Objetivo: {p.goals.map((g) => goalLabels[g]).join(', ')}</p>
    <div class="pc-actions">
      <a class="btn btn-primary btn-sm" href={`/oportunidades/${p.slug}`} data-cta="evaluar-oportunidad">Evaluar esta oportunidad</a>
      <label class="compare-toggle">
        <input type="checkbox" data-compare value={p.slug} aria-label={`Comparar ${p.name}`} />
        <span>Comparar</span>
      </label>
    </div>
  </div>
</article>
<style>
  .project-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; display: flex; flex-direction: column; transition: box-shadow 0.25s var(--ease), transform 0.25s var(--ease); }
  .project-card:hover { box-shadow: var(--shadow); transform: translateY(-3px); }
  .project-card[hidden] { display: none; }
  .pc-media { position: relative; aspect-ratio: 4 / 3; overflow: hidden; }
  .pc-badges { position: absolute; top: var(--space-3); left: var(--space-3); display: flex; gap: var(--space-2); flex-wrap: wrap; }
  .pc-body { padding: var(--space-5); display: flex; flex-direction: column; flex: 1; }
  .pc-body h3 { margin-bottom: var(--space-1); }
  .pc-body h3 a { color: var(--ink); text-decoration: none; }
  .pc-body h3 a:hover { color: var(--brand-orange-deep); }
  .pc-loc { color: var(--text-muted); font-size: var(--fs-sm); margin-bottom: var(--space-4); }
  .pc-facts { margin: 0 0 var(--space-4); display: grid; gap: var(--space-2); font-size: var(--fs-sm); }
  .pc-facts div { display: flex; justify-content: space-between; gap: var(--space-3); border-bottom: 1px dashed var(--border); padding-bottom: var(--space-2); }
  .pc-facts dt { color: var(--text-muted); }
  .pc-facts dd { margin: 0; font-weight: 600; text-align: right; display: flex; gap: var(--space-2); align-items: center; flex-wrap: wrap; justify-content: flex-end; }
  .pc-highlights { margin: 0 0 var(--space-3); padding-left: 1.1em; font-size: var(--fs-sm); }
  .pc-actions { margin-top: auto; display: flex; justify-content: space-between; align-items: center; gap: var(--space-3); flex-wrap: wrap; }
  .compare-toggle { display: inline-flex; align-items: center; gap: var(--space-2); font-size: var(--fs-sm); font-weight: 600; cursor: pointer; min-height: 44px; }
  .compare-toggle input { width: 20px; height: 20px; accent-color: var(--brand-orange-deep); }
</style>
