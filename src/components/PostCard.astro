---
import type { CollectionEntry } from 'astro:content';
import ArchVisual from './ArchVisual.astro';
import { blogSlot } from '@/data/images';
interface Props { post: CollectionEntry<'blog'>; index?: number; }
const { post, index = 0 } = Astro.props;
---
<article class="post-card reveal">
  <a href={`/blog/${post.id}`} class="post-link">
    <div class="post-media"><ArchVisual variant="card" slot={blogSlot(post.data.category)} seed={index + 3} label="" /></div>
    <div class="post-body">
      <span class="eyebrow">{post.data.category}</span>
      <h3>{post.data.title}</h3>
      <p class="muted small">{post.data.description}</p>
      <span class="small muted">{post.data.readingMinutes} min de lectura</span>
    </div>
  </a>
</article>
<style>
  .post-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); overflow: hidden; transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease); }
  .post-card:hover { transform: translateY(-4px); box-shadow: var(--shadow); }
  .post-link { display: flex; flex-direction: column; height: 100%; color: inherit; text-decoration: none; }
  .post-media { aspect-ratio: 16 / 9; overflow: hidden; }
  .post-body { padding: var(--space-5); display: flex; flex-direction: column; flex: 1; }
  .post-body h3 { font-size: var(--fs-lg); }
  .post-body > span:last-child { margin-top: auto; }
</style>
