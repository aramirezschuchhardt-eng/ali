---
import { objectives } from '@/data/content';
---
<div class="grid grid-4 objectives">
  {objectives.map((o, i) => (
    <article class="card objective reveal">
      <span class="obj-n" aria-hidden="true">0{i + 1}</span>
      <h3>{o.title}</h3>
      <p class="muted">{o.text}</p>
      <ul>{o.points.map((p) => <li>{p}</li>)}</ul>
      <a class="btn btn-ghost" href={`/contacto?objetivo=${o.slug}#diagnostico`} data-cta={`objetivo-${o.slug}`}>Conversemos sobre tu objetivo →</a>
    </article>
  ))}
</div>
<style>
  .objective { display: flex; flex-direction: column; transition: transform 0.25s var(--ease), box-shadow 0.25s var(--ease), border-color 0.25s; }
  .objective:hover { transform: translateY(-4px); box-shadow: var(--shadow); border-color: var(--brand-orange); }
  .obj-n { font-family: var(--font-display); font-size: 2rem; color: var(--brand-orange); line-height: 1; margin-bottom: var(--space-4); }
  .objective ul { margin: 0 0 var(--space-5); padding-left: 1.1em; font-size: var(--fs-sm); }
  .objective .btn { margin-top: auto; align-self: flex-start; }
</style>
